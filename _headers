# Render / Netlify-style headers — keep HTML + version always fresh
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache
